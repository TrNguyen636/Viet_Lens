# ==============================================================================
# VIETLENS PYTHON AI MICROSERVICE (PaiService) ENVIRONMENT VARIABLES
# ==============================================================================
# Sao chép file này thành .env trong thư mục VLensBE/PaiService hoặc dùng chung với VLensBE/.env

# --- Supabase API (Read-only di sản văn hóa) ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Lưu ý bảo mật: Chỉ dùng ANON / PUBLIC key cho PaiService
SUPABASE_KEY=<your-supabase-anon-key>
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# --- Cấu hình Server PaiService ---
PAI_SERVICE_HOST=0.0.0.0
PAI_SERVICE_PORT=8000
MODEL_PATH=efficientnet_b0_central_vn_vqa.pth

# --- Qwen2.5-VL Vision Server (Google Colab qua Ngrok Tunnel) ---
# Điền URL công khai sinh ra từ Colab (server_ngrok.ipynb):
# Ví dụ: https://xxxx-xx-xx-xx.ngrok-free.app
# Hoặc URL mock server khi test cục bộ không cần GPU: http://127.0.0.1:8080
QWEN_VISION_URL=https://<your-ngrok-subdomain>.ngrok-free.app
QWEN_TIMEOUT_SECONDS=35
