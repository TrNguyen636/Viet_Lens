# ==============================================================================
# VIETLENS BACKEND (JBE & PaiService) ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env containing real production credentials to Git!

# --- Supabase Database (Postgres Pooler) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<your-project-ref>
DB_PASSWORD=<your-database-password>

# --- Supabase API & Auth ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
# IMPORTANT: For PaiService (read-only lookup), only use the ANON/PUBLIC key.
# DO NOT place service_role key here if service is publicly accessible!
SUPABASE_KEY=<your-supabase-anon-key>
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Supabase Auth verification in Spring Boot
SUPABASE_PROJECT_URL=https://<your-project-ref>.supabase.co
SUPABASE_JWKS_URI=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<your-project-ref>.supabase.co/auth/v1
SUPABASE_JWT_SECRET=

# --- Groq AI API (Trợ lý trò chuyện lịch sử) ---
GROQ_API_KEY=<your-groq-api-key>

# --- PaiService (Python AI Microservice) ---
PAI_SERVICE_HOST=0.0.0.0
PAI_SERVICE_PORT=8000
MODEL_PATH=efficientnet_b0_central_vn_vqa.pth

# --- Qwen2.5-VL Vision Server (Google Colab via Ngrok hoặc Mock Server) ---
# Địa chỉ URL công khai do Ngrok sinh ra trên Google Colab khi chạy server_ngrok.ipynb
# Ví dụ: https://xxxx-xx-xx-xx.ngrok-free.app
# Hoặc chạy thử nghiệm offline bằng mock_server: http://127.0.0.1:8080
QWEN_VISION_URL=https://<your-ngrok-subdomain>.ngrok-free.app
QWEN_TIMEOUT_SECONDS=35
