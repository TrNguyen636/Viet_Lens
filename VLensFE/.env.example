# ==============================================================================
# VIETLENS FRONTEND (Expo / React Native) ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env or .env.local

# --- Supabase Public Credentials ---
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<your-supabase-publishable-or-anon-key>
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# --- Backend Spring Boot Base URL ---
# Web: http://localhost:8080
# Android Emulator: http://10.0.2.2:8080
# Physical Device (Expo Go via Wi-Fi LAN): http://<YOUR_LAN_IP>:8080
EXPO_PUBLIC_API_URL=http://<YOUR_LAN_IP>:8080

# --- Python AI Microservice (PaiService) Base URL ---
# Local/LAN: http://<YOUR_LAN_IP>:8000
# Tunnel (ngrok / localtunnel / cloudflare): https://<your-subdomain>.loca.lt
EXPO_PUBLIC_AI_API_URL=http://<YOUR_LAN_IP>:8000
